<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#"
     xml:base="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify">
        <rdfs:label xml:lang="es">Ontología del SGC de Spotify</rdfs:label>
        <rdfs:comment xml:lang="es">Ontología del sistema de gestión del conocimiento del área de desarrollo de software de Spotify: áreas, equipos, servicios, incidentes, usuarios y los tipos de documento que clasifica el prototipo.</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>

    <!-- ///////////// Object Properties ///////////// -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#esMiembroDe">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Colaborador"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Squad"/>
        <rdfs:label xml:lang="es">es miembro de</rdfs:label>
        <rdfs:comment xml:lang="es">El colaborador pertenece a un squad.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#formaParteDe">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Squad"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Tribu"/>
        <rdfs:label xml:lang="es">forma parte de</rdfs:label>
        <rdfs:comment xml:lang="es">El squad pertenece a una tribu.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#esResponsableDe">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#tieneResponsable"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Squad"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#ServicioSoftware"/>
        <rdfs:label xml:lang="es">es responsable de</rdfs:label>
        <rdfs:comment xml:lang="es">El squad es dueño de un servicio y lo mantiene.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#tieneResponsable">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#ServicioSoftware"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Squad"/>
        <rdfs:label xml:lang="es">tiene responsable</rdfs:label>
        <rdfs:comment xml:lang="es">Inversa de «es responsable de».</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#desarrolla">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Squad"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Funcionalidad"/>
        <rdfs:label xml:lang="es">desarrolla</rdfs:label>
        <rdfs:comment xml:lang="es">El squad construye una funcionalidad del producto.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#utilizaHerramienta">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Squad"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Herramienta"/>
        <rdfs:label xml:lang="es">utiliza herramienta</rdfs:label>
        <rdfs:comment xml:lang="es">El squad trabaja con una herramienta interna.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#seImplementaEn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Funcionalidad"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#ServicioSoftware"/>
        <rdfs:label xml:lang="es">se implementa en</rdfs:label>
        <rdfs:comment xml:lang="es">La funcionalidad corre sobre un servicio de software.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#dependeDe">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#ServicioSoftware"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#ServicioSoftware"/>
        <rdfs:label xml:lang="es">depende de</rdfs:label>
        <rdfs:comment xml:lang="es">Un servicio necesita de otro para funcionar.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#afecta">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Incidente"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#ServicioSoftware"/>
        <rdfs:label xml:lang="es">afecta</rdfs:label>
        <rdfs:comment xml:lang="es">El incidente interrumpe o degrada un servicio.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#usaFuncionalidad">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Usuario"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Funcionalidad"/>
        <rdfs:label xml:lang="es">usa funcionalidad</rdfs:label>
        <rdfs:comment xml:lang="es">El usuario utiliza una funcionalidad de la app.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#genera">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Usuario"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#DatosUsuarios"/>
        <rdfs:label xml:lang="es">genera</rdfs:label>
        <rdfs:comment xml:lang="es">El uso de la app produce datos del usuario.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#esGeneradoPor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Documento"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#AreaOrganizacional"/>
        <rdfs:label xml:lang="es">es generado por</rdfs:label>
        <rdfs:comment xml:lang="es">Área que escribe y actualiza el documento.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#seAlmacenaEn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Documento"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Herramienta"/>
        <rdfs:label xml:lang="es">se almacena en</rdfs:label>
        <rdfs:comment xml:lang="es">Herramienta donde se guarda el documento.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#documenta">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#DocumentacionTecnica"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#ServicioSoftware"/>
        <rdfs:label xml:lang="es">documenta</rdfs:label>
        <rdfs:comment xml:lang="es">La documentación explica cómo funciona o se opera un servicio.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#analiza">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#esAnalizadoEn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#ReporteIncidente"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Incidente"/>
        <rdfs:label xml:lang="es">analiza</rdfs:label>
        <rdfs:comment xml:lang="es">El postmortem explica la causa y las acciones de un incidente.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#esAnalizadoEn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Incidente"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#ReporteIncidente"/>
        <rdfs:label xml:lang="es">es analizado en</rdfs:label>
        <rdfs:comment xml:lang="es">Inversa de «analiza».</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#evalua">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#ResultadoExperimentoAB"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Funcionalidad"/>
        <rdfs:label xml:lang="es">evalúa</rdfs:label>
        <rdfs:comment xml:lang="es">El experimento mide el efecto de una funcionalidad.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#regula">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#PoliticaInterna"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Colaborador"/>
        <rdfs:label xml:lang="es">regula</rdfs:label>
        <rdfs:comment xml:lang="es">La política define lo que deben hacer los colaboradores.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#protege">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#PoliticaInterna"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#DatosUsuarios"/>
        <rdfs:label xml:lang="es">protege</rdfs:label>
        <rdfs:comment xml:lang="es">La política establece cómo cuidar los datos de los usuarios.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#describe">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#InvestigacionUsuarios"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Usuario"/>
        <rdfs:label xml:lang="es">describe</rdfs:label>
        <rdfs:comment xml:lang="es">La investigación explica cómo se comportan y qué necesitan los usuarios.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ///////////// Data Properties ///////////// -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#idDocumento">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Documento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="es">id de documento</rdfs:label>
        <rdfs:comment xml:lang="es">Identificador del documento en el conjunto de prueba (por ejemplo RI08).</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#titulo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Documento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="es">título</rdfs:label>
        <rdfs:comment xml:lang="es">Título del documento.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#confianzaClasificacion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Documento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="es">confianza de clasificación</rdfs:label>
        <rdfs:comment xml:lang="es">Probabilidad que el clasificador asignó a la categoría de un documento nuevo.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#nombre">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#AreaOrganizacional"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Equipo"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#ServicioSoftware"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Funcionalidad"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Herramienta"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Colaborador"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="es">nombre</rdfs:label>
        <rdfs:comment xml:lang="es">Nombre con el que se identifica el elemento.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#rol">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Colaborador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="es">rol</rdfs:label>
        <rdfs:comment xml:lang="es">Puesto del colaborador (ingeniero, product manager, etc.).</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#descripcion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Incidente"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="es">descripción</rdfs:label>
        <rdfs:comment xml:lang="es">Resumen breve del incidente.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#prioridad">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Incidente"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P1</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P2</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P3</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="es">prioridad</rdfs:label>
        <rdfs:comment xml:lang="es">Prioridad del incidente según su impacto.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- ///////////// Classes ///////////// -->

    <owl:Class rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#AreaOrganizacional">
        <rdfs:label xml:lang="es">Área organizacional</rdfs:label>
        <rdfs:comment xml:lang="es">Área de la empresa que genera, usa o actualiza conocimiento.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Colaborador">
        <rdfs:label xml:lang="es">Colaborador</rdfs:label>
        <rdfs:comment xml:lang="es">Persona que trabaja en el área de desarrollo de software (ingeniero, product manager, investigador).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Equipo">
        <rdfs:label xml:lang="es">Equipo</rdfs:label>
        <rdfs:comment xml:lang="es">Grupo de colaboradores organizado para desarrollar el producto.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Squad">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Equipo"/>
        <rdfs:label xml:lang="es">Squad</rdfs:label>
        <rdfs:comment xml:lang="es">Equipo pequeño y autónomo dueño de una parte del producto.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Tribu">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Equipo"/>
        <rdfs:label xml:lang="es">Tribu</rdfs:label>
        <rdfs:comment xml:lang="es">Grupo de squads que trabajan en un área de negocio relacionada.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#ServicioSoftware">
        <rdfs:label xml:lang="es">Servicio de software</rdfs:label>
        <rdfs:comment xml:lang="es">Microservicio de la plataforma (pagos, cuentas, autenticación, búsqueda).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Funcionalidad">
        <rdfs:label xml:lang="es">Funcionalidad</rdfs:label>
        <rdfs:comment xml:lang="es">Característica del producto que ve el usuario (playlists, letras, recordatorios).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Incidente">
        <rdfs:label xml:lang="es">Incidente</rdfs:label>
        <rdfs:comment xml:lang="es">Falla que afecta a un servicio de software.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Usuario">
        <rdfs:label xml:lang="es">Usuario</rdfs:label>
        <rdfs:comment xml:lang="es">Persona que usa Spotify.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#DatosUsuarios">
        <rdfs:label xml:lang="es">Datos de usuarios</rdfs:label>
        <rdfs:comment xml:lang="es">Información de escucha y de cuenta que la empresa debe proteger.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Herramienta">
        <rdfs:label xml:lang="es">Herramienta</rdfs:label>
        <rdfs:comment xml:lang="es">Herramienta interna donde se registran servicios y documentación (por ejemplo Backstage).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Documento">
        <rdfs:label xml:lang="es">Documento</rdfs:label>
        <rdfs:comment xml:lang="es">Registro escrito del conocimiento del área; es lo que clasifica y busca el prototipo.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#DocumentacionTecnica">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sgc-spotify/ontologies/sgc-spotify#Documento"/>
        <rdfs:label xml:lang="es">Documentación técnica</rdfs:label>
        <rdfs:comment xml:lang="es">Guías de despliegue, APIs, arquitectura y manuales de monitoreo.</rdfs:comment>
    </owl:Class>

